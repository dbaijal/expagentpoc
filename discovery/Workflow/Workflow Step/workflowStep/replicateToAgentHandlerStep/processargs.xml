<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0"
    jcr:primaryType="cq:Panel"
    title="Arguments">
    <items jcr:primaryType="cq:WidgetCollection">
        <arguments
            jcr:primaryType="cq:Widget"
            collapsed="{Boolean}false"
            collapsible="{Boolean}false"
            title="Process Arguments"
            xtype="dialogfieldset">
            <items jcr:primaryType="cq:WidgetCollection">
                <agentId
                    jcr:primaryType="cq:Widget"
                    fieldDescription="Id of the Replication Agent to be used (Id is the name in the round brackets)."
                    fieldLabel="Agent ID"
                    name="./metaData/agentId"
                    xtype="textfield"/>
                <activationType
                    jcr:primaryType="cq:Widget"
                    fieldDescription="Activation Type of the Replication which can be ACTIVATE or DEACTIVATE"
                    fieldLabel="Activation Type"
                    name="./metaData/activationType"
                    xtype="textfield"/>
            </items>
        </arguments>
    </items>
</jcr:root>
